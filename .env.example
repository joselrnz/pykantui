# --- generated from the provider specs; edit values, not structure ---
# ==========================================================================
#  pykantui credentials
#
#  Copy this to .env and fill in what you need. .env is gitignored and must
#  stay that way: every value below is a live credential.
#
#  You only ever need the TOKEN by hand. Every id can be discovered once its
#  token works:
#
#      kbn init --type <tracker> --list-ids
#
#  Provider identity and credential notes: docs/provider-identity.md
# ==========================================================================


# --- ASANA -------------------------------------------- verified live ---
# token: https://app.asana.com/0/my-apps

# required
#   My Settings -> Apps -> Manage developer apps.
#   e.g. 1/1234567890:abcdef...
ASANA_TOKEN=

# required   (discover:  kbn init --type asana --list-ids)
#   Asana calls this a gid.
#   e.g. 1201234567890123   (a numeric gid)
ASANA_PROJECT_ID=

# optional
#   Narrows the project list on a multi-workspace account.
#   e.g. 1200000000000000   (also a gid)
ASANA_WORKSPACE=


# --- CLICKUP ------------------------------------------ verified live ---
# token: https://app.clickup.com/settings/apps

# required
#   Settings -> Apps -> API token. Starts with pk_.
#   e.g. pk_12345678_ABCDEF...
CLICKUP_TOKEN=

# required   (discover:  kbn init --type clickup --list-ids)
#   A ClickUp list is the board.
#   e.g. 901418942017   (numeric; a *list* is the board)
CLICKUP_LIST_ID=


# --- GITHUB --------------------------------------------- verified live ---
# token: https://github.com/settings/tokens

# required
#   A fine-grained or classic PAT with repo issue access.
#   e.g. github_pat_11A...   or   ghp_...
GITHUB_TOKEN=

# optional
#   Change this only for GitHub Enterprise Server.
#   e.g. https://api.github.com
GITHUB_API_URL=

# required   (discover:  kbn init --type github --list-ids)
#   e.g. acme/widgets   (owner/name, not a URL)
GITHUB_REPOSITORY=


# --- FORGEJO -------------------------------------------- live verified ---
# token: https://forgejo.org/docs/latest/user/api/usage/#generating-and-listing-api-tokens

# required
#   Your Forgejo instance URL. /api/v1 is added automatically.
#   e.g. https://codeberg.org   or   https://git.example.com
#   Private-CA instances may also require SSL_CERT_FILE=/path/to/rootCA.pem,
#   exported in the shell before launch (workspace .env files cannot set TLS controls).
FORGEJO_URL=

# required
#   Settings -> Applications -> Generate New Token.
#   Grant read:user, read:repository, and write:issue for full sync support.
FORGEJO_TOKEN=

# required   (discover:  kbn init --type forgejo --list-ids)
#   e.g. acme/widgets   (owner/name, not a URL)
FORGEJO_REPOSITORY=

# optional
#   Labels beginning with this prefix become kanban columns.
#   Defaults to status: when blank.
FORGEJO_LABEL_PREFIX=


# --- JIRA --------------------------------------------- verified live ---
# token: https://id.atlassian.com/manage-profile/security/api-tokens

# required
#   Your Atlassian site, without a path.
#   e.g. https://acme.atlassian.net
JIRA_BASE_URL=

# required
#   Jira Cloud signs API requests with your email and the token together.
#   e.g. you@example.com
JIRA_EMAIL=

# required
#   Created at id.atlassian.com -- not your account password.
#   e.g. ATATT3xFfGF0...   (long, starts with ATATT)
JIRA_TOKEN=

# required   (discover:  kbn init --type jira --list-ids)
#   e.g. ACME
JIRA_PROJECT_KEY=

# optional
#   Takes the column layout from this board instead of the raw statuses.
#   e.g. 3   (the ?rapidView= number in the board URL)
JIRA_BOARD_ID=


# --- LINEAR ------------------------------------------- verified live ---
# token: https://linear.app/settings/api

# required
#   Settings -> API -> Personal API keys. Starts with lin_api_.
#   e.g. lin_api_...
LINEAR_TOKEN=

# required   (discover:  kbn init --type linear --list-ids)
#   Linear boards belong to a team, not to a project. Key or name is fine.
#   e.g. ENG   (the team key or name; a UUID also works)
LINEAR_TEAM_ID=


# --- MONDAY.COM --------------------------------------- verified live ---
# token: https://monday.com/developers/v2

# required
#   Profile -> Developers -> My access tokens.
#   e.g. a long JWT, from Profile -> Developers
MONDAY_TOKEN=

# required   (discover:  kbn init --type monday --list-ids)
#   e.g. 1234567890   (the digits in the board URL)
MONDAY_BOARD_ID=

# optional
#   Which status column is the kanban axis, on a board with several.
#   e.g. status   (the column id, not its title)
MONDAY_STATUS_COLUMN=

# optional
#   Long-text column used for the card description.
MONDAY_DESCRIPTION_COLUMN=

# optional
#   People column used for card assignees.
MONDAY_ASSIGNEE_COLUMN=

# optional
#   Dropdown column used for the card type.
MONDAY_TYPE_COLUMN=

# optional
#   Status column used for card priority.
MONDAY_PRIORITY_COLUMN=

# optional
#   Dropdown column used for card labels.
MONDAY_LABELS_COLUMN=

# optional
#   Date column used for card due dates.
MONDAY_DUE_COLUMN=


# --- PLANE -------------------------------------------- verified live ---
# token: https://app.plane.so/profile/api-tokens

# optional
#   Change this only for a self-hosted Plane.
#   e.g. https://api.plane.so
PLANE_BASE_URL=

# required
#   Workspace settings -> API tokens. Starts with plane_api_.
#   e.g. plane_api_...
PLANE_TOKEN=

# required
#   The first path segment of your Plane URL.
#   e.g. acme   (first path segment of app.plane.so/<this>/)
PLANE_WORKSPACE=

# required   (discover:  kbn init --type plane --list-ids)
#   Plane identifies projects by UUID.
#   e.g. 11111111-2222-3333-4444-555555555555   (a UUID)
PLANE_PROJECT_ID=


# --- SHORTCUT ----------------------------------------- verified live ---
# token: https://app.shortcut.com/settings/account/api-tokens

# required
#   Settings -> API Tokens.
#   e.g. from Settings -> API Tokens
SHORTCUT_TOKEN=

# required   (discover:  kbn init --type shortcut --list-ids)
#   A Shortcut workflow is the board.
#   e.g. 500000005   (numeric; a workflow is the board)
SHORTCUT_WORKFLOW_ID=


# --- TRELLO ------------------------------------------- verified live ---
# token: https://trello.com/apps/admin

# required
#   Power-Up Admin Portal -> your Power-Up -> API Key tab. Public, not secret.
#   e.g. 32-character hex, from a Power-Up at trello.com/apps/admin
TRELLO_KEY=

# required
#   The 'Token' link beside the API key. Grants full account access.
#   e.g. ATTA...   (from the authorise URL; NOT an ATATT... Jira token)
TRELLO_TOKEN=

# required   (discover:  kbn init --type trello --list-ids)
#   Trello identifies boards by a 24-character id.
#   e.g. 5f2a1b9c4d3e2f1a0b9c8d7e   (24-char id, or the 8-char shortLink)
TRELLO_BOARD_ID=
