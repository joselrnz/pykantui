msgid "mirror the whole project, whatever the workspace is set to"
msgstr "mencerminkan keseluruhan proyek, apa pun ruang kerja yang diatur"

#: src/pykantui/commands/sync.py:51
msgid "send even where the provider also changed the issue, overwriting it"
msgstr "kirim bahkan ketika penyedia juga mengubah masalahnya, menimpanya"

#: src/pykantui/commands/sync.py:56
msgid "use provider values for conflicts while sending safe local changes"
msgstr ""
"gunakan nilai penyedia untuk konflik sambil mengirim perubahan lokal yang "
"aman"

#: src/pykantui/commands/sync.py:61
msgid ""
"retry draft creates whose previous outcome was unknown, after checking the "
"provider"
msgstr ""
"coba lagi membuat draf yang hasil sebelumnya tidak diketahui, setelah "
"memeriksa penyedia"

