msgid "make a hidden column visible"
msgstr "Eine ausgeblendete Spalte sichtbar machen"

#: src/pykantui/commands/columns.py:58
msgid "hide a column without deleting it"
msgstr "eine Spalte ausblenden, ohne sie zu löschen"

#: src/pykantui/commands/columns.py:63
msgid "set the number of visible columns, adding or removing at the end"
msgstr ""
"Legen Sie die Anzahl der sichtbaren Spalten fest und fügen Sie sie am Ende "
"hinzu oder entfernen Sie sie"

