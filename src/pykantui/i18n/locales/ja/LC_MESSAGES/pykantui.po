#: src/pykantui/cli/main.py:33
msgid "Terminal kanban board"
msgstr "ターミナルかんばん"

#: src/pykantui/cli/main.py:39
msgid "interface language; saved to config.json (default: auto)"
msgstr "インターフェース言語。 config.json に保存 (デフォルト: 自動)"

#: src/pykantui/cli/main.py:45
msgid ""
"adjacent commits H/L immediately; jump highlights a column and waits for "
"enter"
msgstr "隣接する場合は H/L を即座にコミットします。ジャンプは列をハイライトし、入力を待ちます"

