#: src/pykantui/cli/main.py:33
msgid "Terminal kanban board"
msgstr "Bảng Kanban trong terminal"

#: src/pykantui/cli/main.py:39
msgid "interface language; saved to config.json (default: auto)"
msgstr "ngôn ngữ giao diện; đã lưu vào config.json (mặc định: tự động)"

#: src/pykantui/cli/main.py:45
msgid ""
"adjacent commits H/L immediately; jump highlights a column and waits for "
"enter"
msgstr "liền kề cam kết H/L ngay lập tức; nhảy đánh dấu một cột và chờ nhập"

#: src/pykantui/cli/main.py:50
msgid "theme name; saved to config.json (default: cyberpunk)"
msgstr "tên chủ đề; đã lưu vào config.json (mặc định: cyberpunk)"

#: src/pykantui/cli/main.py:56
msgid "corner style for cards, fields and dialogs; saved to config.json"
msgstr "kiểu góc cho thẻ, trường và hộp thoại; đã lưu vào config.json"

#: src/pykantui/cli/main.py:62
msgid "apply column moves without the confirmation dialog"
msgstr "áp dụng di chuyển cột mà không có hộp thoại xác nhận"

#: src/pykantui/cli/main.py:66
msgid "open a throwaway board with sample tasks"
msgstr "mở một bảng dùng một lần với các nhiệm vụ mẫu"

#: src/pykantui/cli/main.py:68
msgid "open a local JSON board (the default)"
msgstr "mở một bảng JSON cục bộ (mặc định)"

#: src/pykantui/cli/main.py:69
msgid "path to the board file"
msgstr "đường dẫn đến tập tin bảng"

#: src/pykantui/cli/main.py:71
msgid "print the board as text, without starting the TUI"
msgstr "in bảng dưới dạng văn bản mà không cần khởi động TUI"

#: src/pykantui/cli/main.py:146 src/pykantui/cli/main.py:237
#, python-brace-format
msgid "error: {error}"
msgstr "lỗi: {error}"

#: src/pykantui/cli/main.py:238
msgid "(run `kbn sync` to fix, or `kbn board --file ...` for a local board)"
msgstr "(chạy `kbn sync` để sửa hoặc `kbn board --file ...` cho bảng cục bộ)"

#: src/pykantui/commands/columns.py:24
