msgid "change a column's position"
msgstr "zmienić położenie kolumny"

#: src/pykantui/commands/columns.py:46
msgid "1-based position"
msgstr "Stanowisko oparte na 1"

#: src/pykantui/commands/columns.py:48
msgid "set which column means reset, start or finish"
msgstr "ustaw, która kolumna oznacza reset, początek lub koniec"

#: src/pykantui/commands/columns.py:52
msgid "set the provider statuses that land in a column"
msgstr "ustaw statusy dostawców, które wylądują w kolumnie"

#: src/pykantui/commands/columns.py:54
msgid "comma-separated; empty string clears them"
msgstr "oddzielone przecinkami; pusty ciąg czyści je"

#: src/pykantui/commands/columns.py:56
msgid "make a hidden column visible"
msgstr "pokaż ukrytą kolumnę"

#: src/pykantui/commands/columns.py:58
msgid "hide a column without deleting it"
msgstr "ukryć kolumnę bez jej usuwania"

#: src/pykantui/commands/columns.py:63
msgid "set the number of visible columns, adding or removing at the end"
msgstr "ustaw liczbę widocznych kolumn, dodając lub usuwając na końcu"

#: src/pykantui/commands/columns.py:67
msgid "restore the default shape"
msgstr "przywróć domyślny kształt"

#: src/pykantui/commands/columns.py:68 src/pykantui/commands/tasks.py:45
msgid "skip the confirmation"
msgstr "pomiń potwierdzenie"

#: src/pykantui/commands/graph.py:25
msgid "render the workspace as an HTML graph"
msgstr "wyrenderuj obszar roboczy jako wykres HTML"

#: src/pykantui/commands/graph.py:27 src/pykantui/commands/sync.py:31
msgid "the workspace (default: found by walking up)"
msgstr "obszar roboczy (domyślnie: znaleziony po wejściu na górę)"

#: src/pykantui/commands/graph.py:32
#, python-brace-format
msgid "where to write it (default: ./{name})"
msgstr "gdzie to napisać (domyślnie: ./{name})"

#: src/pykantui/commands/graph.py:34
msgid "open it in a browser afterwards"
msgstr "otwórz go później w przeglądarce"

#: src/pykantui/commands/init.py:43
msgid "create a workspace from a tracker"
msgstr "utwórz obszar roboczy z modułu śledzącego"

#: src/pykantui/commands/init.py:45
msgid "which tracker; see --list-types"
msgstr "który tracker; patrz --list-types"

#: src/pykantui/commands/init.py:46
msgid "print the available trackers and exit"
msgstr "wydrukuj dostępne moduły śledzące i wyjdź"

#: src/pykantui/commands/init.py:50
msgid "print the boards/projects this token can see, ready to paste into .env"
msgstr ""
"wydrukuj tablice/projekty, które może zobaczyć ten token, gotowe do "
"wklejenia do .env"

#: src/pykantui/commands/init.py:52
msgid "where to create the workspace"
msgstr "gdzie utworzyć przestrzeń roboczą"

#: src/pykantui/commands/init.py:53
msgid "a name for the workspace"
msgstr "nazwa obszaru roboczego"

#: src/pykantui/commands/init.py:58
msgid "type the path instead of browsing for it"
msgstr "wpisz ścieżkę zamiast jej szukać"

#: src/pykantui/commands/init.py:64
msgid "column folder naming (default: slug — lowercase, dashes)"
msgstr "nazewnictwo folderów kolumnowych (domyślnie: slug — małe litery, myślniki)"

#: src/pykantui/commands/init.py:66
msgid "do not create a git repository"
msgstr "nie twórz repozytorium git"

#: src/pykantui/commands/init.py:67
msgid "set up but do not pull yet"
msgstr "załóż, ale jeszcze nie ciągnij"

#: src/pykantui/commands/init.py:72
msgid "finish after setup instead of opening the new board"
msgstr "zakończ po instalacji, zamiast otwierać nową tablicę"

#: src/pykantui/commands/init.py:74
msgid "never prompt; fail instead"
msgstr "nigdy nie monituj; zamiast tego ponieść porażkę"

