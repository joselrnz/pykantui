msgid "delete a column and rehome its cards"
msgstr "usuń kolumnę i zmień położenie jej kart"

#: src/pykantui/commands/columns.py:42
msgid "where its cards go (default: the first column)"
msgstr "dokąd idą jego karty (domyślnie: pierwsza kolumna)"

