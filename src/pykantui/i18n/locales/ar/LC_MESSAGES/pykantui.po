#: src/pykantui/cli/main.py:33
msgid "Terminal kanban board"
msgstr "لوحة كانبان في الطرفية"

#: src/pykantui/cli/main.py:39
msgid "interface language; saved to config.json (default: auto)"
msgstr "لغة الواجهة تم الحفظ في config.json (الافتراضي: تلقائي)"

#: src/pykantui/cli/main.py:45
msgid ""
"adjacent commits H/L immediately; jump highlights a column and waits for "
"enter"
msgstr "يلتزم المجاور H/L على الفور؛ الانتقال يسلط الضوء على عمود وينتظر الدخول"

#: src/pykantui/cli/main.py:50
msgid "theme name; saved to config.json (default: cyberpunk)"
msgstr "اسم الموضوع؛ تم الحفظ في config.json (الافتراضي: cyberpunk)"

#: src/pykantui/cli/main.py:56
msgid "corner style for cards, fields and dialogs; saved to config.json"
msgstr "نمط الزاوية للبطاقات والحقول ومربعات الحوار؛ تم الحفظ في config.json"

#: src/pykantui/cli/main.py:62
msgid "apply column moves without the confirmation dialog"
msgstr "تطبيق تحركات الأعمدة بدون مربع حوار التأكيد"

#: src/pykantui/cli/main.py:66
msgid "open a throwaway board with sample tasks"
msgstr "افتح لوحة مهمّة تحتوي على نماذج من المهام"

#: src/pykantui/cli/main.py:68
msgid "open a local JSON board (the default)"
msgstr "افتح لوحة JSON محلية (الافتراضية)"

#: src/pykantui/cli/main.py:69
msgid "path to the board file"
msgstr "المسار إلى ملف اللوحة"

#: src/pykantui/cli/main.py:71
msgid "print the board as text, without starting the TUI"
msgstr "طباعة اللوحة كنص، دون بدء تشغيل TUI"

#: src/pykantui/cli/main.py:146 src/pykantui/cli/main.py:237
#, python-brace-format
msgid "error: {error}"
msgstr "الخطأ: {error}"

#: src/pykantui/cli/main.py:238
msgid "(run `kbn sync` to fix, or `kbn board --file ...` for a local board)"
msgstr "(قم بتشغيل `kbn sync` للإصلاح، أو `kbn board --file ...` للوحة المحلية)"

#: src/pykantui/commands/columns.py:24
msgid "add, rename, reorder or delete board columns"
msgstr "إضافة أو إعادة تسمية أو إعادة ترتيب أو حذف أعمدة اللوحة"

#: src/pykantui/commands/columns.py:28
msgid "show the current columns (the default)"
msgstr "إظهار الأعمدة الحالية (الافتراضية)"

#: src/pykantui/commands/columns.py:30
msgid "add a column"
msgstr "إضافة عمود"

#: src/pykantui/commands/columns.py:32
msgid "column id, name or position to insert after"
msgstr "معرف العمود أو الاسم أو الموضع الذي سيتم إدراجه بعده"

#: src/pykantui/commands/columns.py:33
msgid "comma-separated provider statuses for this column"
msgstr "حالات الموفر مفصولة بفواصل لهذا العمود"

#: src/pykantui/commands/columns.py:34
msgid "create it hidden"
msgstr "اجعلها مخفية"

#: src/pykantui/commands/columns.py:36
msgid "rename a column"
msgstr "إعادة تسمية عمود"

#: src/pykantui/commands/columns.py:40
msgid "delete a column and rehome its cards"
msgstr "حذف عمود وإعادة بطاقاته"

#: src/pykantui/commands/columns.py:42
msgid "where its cards go (default: the first column)"
msgstr "أين تذهب بطاقاتها (الافتراضي: العمود الأول)"

#: src/pykantui/commands/columns.py:44
msgid "change a column's position"
msgstr "تغيير موضع العمود"

#: src/pykantui/commands/columns.py:46
msgid "1-based position"
msgstr "1- الموقف القائم"

#: src/pykantui/commands/columns.py:48
msgid "set which column means reset, start or finish"
msgstr "قم بتعيين العمود الذي يعني إعادة التعيين أو البدء أو الانتهاء"

#: src/pykantui/commands/columns.py:52
msgid "set the provider statuses that land in a column"
msgstr "قم بتعيين حالات الموفر التي تصل إلى عمود"

#: src/pykantui/commands/columns.py:54
msgid "comma-separated; empty string clears them"
msgstr "مفصولة بفواصل؛ سلسلة فارغة مسحهم"

#: src/pykantui/commands/columns.py:56
msgid "make a hidden column visible"
msgstr "جعل العمود المخفي مرئيًا"

#: src/pykantui/commands/columns.py:58
msgid "hide a column without deleting it"
msgstr "إخفاء عمود دون حذفه"

#: src/pykantui/commands/columns.py:63
msgid "set the number of visible columns, adding or removing at the end"
msgstr "اضبط عدد الأعمدة المرئية، وقم بإضافتها أو إزالتها في النهاية"

#: src/pykantui/commands/columns.py:67
msgid "restore the default shape"
msgstr "استعادة الشكل الافتراضي"

#: src/pykantui/commands/columns.py:68 src/pykantui/commands/tasks.py:45
msgid "skip the confirmation"
msgstr "تخطي التأكيد"

#: src/pykantui/commands/graph.py:25
msgid "render the workspace as an HTML graph"
msgstr "تقديم مساحة العمل كرسم بياني HTML"

#: src/pykantui/commands/graph.py:27 src/pykantui/commands/sync.py:31
msgid "the workspace (default: found by walking up)"
msgstr "مساحة العمل (الافتراضي: يتم العثور عليها بالمشي لأعلى)"

#: src/pykantui/commands/graph.py:32
#, python-brace-format
msgid "where to write it (default: ./{name})"
msgstr "مكان كتابته (الافتراضي: ./{name})"

#: src/pykantui/commands/graph.py:34
msgid "open it in a browser afterwards"
msgstr "فتحه في المتصفح بعد ذلك"

#: src/pykantui/commands/init.py:43
msgid "create a workspace from a tracker"
msgstr "إنشاء مساحة عمل من جهاز تعقب"

#: src/pykantui/commands/init.py:45
msgid "which tracker; see --list-types"
msgstr "أي تعقب؛ انظر --list-types"

#: src/pykantui/commands/init.py:46
msgid "print the available trackers and exit"
msgstr "طباعة أجهزة التتبع المتاحة والخروج"

#: src/pykantui/commands/init.py:50
msgid "print the boards/projects this token can see, ready to paste into .env"
msgstr ""
"قم بطباعة اللوحات/المشاريع التي يمكن لهذا الرمز المميز رؤيتها، وتكون جاهزة "
"للصقه في .env"

#: src/pykantui/commands/init.py:52
msgid "where to create the workspace"
msgstr "حيث لإنشاء مساحة العمل"

#: src/pykantui/commands/init.py:53
msgid "a name for the workspace"
msgstr "اسم لمساحة العمل"

#: src/pykantui/commands/init.py:58
msgid "type the path instead of browsing for it"
msgstr "اكتب المسار بدلاً من التصفح بحثاً عنه"

#: src/pykantui/commands/init.py:64
msgid "column folder naming (default: slug — lowercase, dashes)"
msgstr "تسمية مجلد العمود (الافتراضي: سبيكة - أحرف صغيرة، شرطات)"

#: src/pykantui/commands/init.py:66
msgid "do not create a git repository"
msgstr "لا تقم بإنشاء مستودع git"

#: src/pykantui/commands/init.py:67
msgid "set up but do not pull yet"
msgstr "إعداد ولكن لا تسحب بعد"

#: src/pykantui/commands/init.py:72
msgid "finish after setup instead of opening the new board"
msgstr "الانتهاء بعد الإعداد بدلاً من فتح اللوحة الجديدة"

#: src/pykantui/commands/init.py:74
msgid "never prompt; fail instead"
msgstr "لا تطالب أبدًا؛ تفشل بدلا من ذلك"

#: src/pykantui/commands/init_interactive.py:113
msgid "Authentication cancelled"
msgstr "Authentication cancelled"

#: src/pykantui/commands/init_interactive.py:140
#, python-brace-format
msgid "Validated project: {project}"
msgstr "Validated project: {project}"

#: src/pykantui/commands/init_interactive.py:176
msgid "skipped"
msgstr "تم التخطي"

#: src/pykantui/commands/init_interactive.py:198
msgid "Setup complete"
msgstr "اكتمل الإعداد"

#: src/pykantui/commands/init_interactive.py:230
msgid "Enter credentials again"
msgstr "Enter credentials again"

#: src/pykantui/commands/init_interactive.py:231
msgid "retry authentication"
msgstr "retry authentication"

#: src/pykantui/commands/init_interactive.py:238
msgid "Cancel setup"
msgstr "Cancel setup"

#: src/pykantui/commands/init_interactive.py:239
msgid "create nothing"
msgstr "create nothing"

#: src/pykantui/commands/init_interactive.py:242
msgid "No workspace or credential file has been created."
msgstr "No workspace or credential file has been created."

#: src/pykantui/commands/init_interactive.py:245
#, python-brace-format
msgid "Could not connect to {provider}"
msgstr "Could not connect to {provider}"

#: src/pykantui/commands/init_interactive.py:246
msgid "retry or cancel"
msgstr "retry or cancel"

#: src/pykantui/commands/init_interactive.py:289
#, python-brace-format
msgid "Configured project {project} is not visible; choose an available project"
msgstr "Configured project {project} is not visible; choose an available project"

#: src/pykantui/commands/init_interactive.py:292
#: src/pykantui/commands/init_interactive.py:300
#: src/pykantui/pages/init_wizard.py:328
#, python-brace-format
msgid "No {provider} projects found"
msgstr "لم يتم العثور على مشاريع {provider}"

#: src/pykantui/commands/init_interactive.py:295
#, python-brace-format
msgid "Checking {provider} projects again"
msgstr "جارٍ التحقق من مشاريع {provider} مرة أخرى"

#: src/pykantui/commands/init_interactive.py:298
#, python-brace-format
msgid "{provider} projects found"
msgstr "تم العثور على مشاريع {provider}"

#: src/pykantui/commands/new.py:44
msgid "draft a story as markdown, without sending it"
msgstr "قم بصياغة قصة كتخفيض، دون إرسالها"

#: src/pykantui/commands/new.py:46
msgid "the story title"
msgstr "عنوان القصة"

#: src/pykantui/commands/new.py:47
msgid "the workspace"
msgstr "مساحة العمل"

#: src/pykantui/commands/new.py:48
msgid "which column to draft it into"
msgstr "في أي عمود سيتم صياغته"

#: src/pykantui/commands/new.py:53
msgid "issue type; see --types for what this project accepts"
msgstr "نوع الإصدار؛ راجع --types لمعرفة ما يقبله هذا المشروع"

#: src/pykantui/commands/new.py:55
msgid "the description"
msgstr "الوصف"

#: src/pykantui/commands/new.py:56
msgid "key of the epic it belongs to"
msgstr "مفتاح الملحمة التي تنتمي إليها"

#: src/pykantui/commands/new.py:57
msgid "repeatable"
msgstr "قابل للتكرار"

#: src/pykantui/commands/new.py:58
msgid "repeatable Jira component"
msgstr "مكوّن Jira قابل للتكرار"

#: src/pykantui/commands/new.py:61
msgid "list the columns and exit"
msgstr "قائمة الأعمدة والخروج"

#: src/pykantui/commands/new.py:62
msgid "list the issue types and exit"
msgstr "قائمة أنواع المشكلة والخروج"

#: src/pykantui/commands/new.py:63
msgid "list Jira components and exit"
msgstr "عرض مكوّنات Jira والخروج"

#: src/pykantui/commands/new.py:67
msgid "do not assign it to yourself (drafts are your work by default)"
msgstr "لا تقم بتعيينه لنفسك (المسودات هي عملك بشكل افتراضي)"

#: src/pykantui/commands/sync.py:29
msgid "reconcile a workspace with its provider"
msgstr "التوفيق بين مساحة العمل ومزودها"

#: src/pykantui/commands/sync.py:32
msgid "do not ask before sending changes to the provider"
msgstr "لا تسأل قبل إرسال التغييرات إلى الموفر"

#: src/pykantui/commands/sync.py:33
msgid "show what would be sent, and send nothing"
msgstr "إظهار ما سيتم إرساله، وعدم إرسال أي شيء"

#: src/pykantui/commands/sync.py:34
msgid "never send, whatever changed locally"
msgstr "لا ترسل أبدا، مهما تغير محليا"

#: src/pykantui/commands/sync.py:35
msgid "ignore the cached issue list"
msgstr "تجاهل قائمة المشكلات المخزنة مؤقتًا"

#: src/pykantui/commands/sync.py:39
msgid "write only issues assigned to or reported by you (the cache still holds all)"
msgstr ""
"اكتب فقط المشكلات التي تم تعيينها لك أو الإبلاغ عنها بواسطتك (لا تزال ذاكرة "
"التخزين المؤقت تحتوي على الكل)"

#: src/pykantui/commands/sync.py:45
msgid "mirror the whole project, whatever the workspace is set to"
msgstr "قم بعكس المشروع بأكمله، مهما كانت مساحة العمل التي تم تعيينها عليها"

#: src/pykantui/commands/sync.py:51
msgid "send even where the provider also changed the issue, overwriting it"
msgstr "إرسال حتى حيث قام الموفر أيضًا بتغيير المشكلة، والكتابة فوقها"

#: src/pykantui/commands/sync.py:56
msgid "use provider values for conflicts while sending safe local changes"
msgstr "استخدام قيم المزوّد عند التعارضات مع إرسال التغييرات المحلية الآمنة"

#: src/pykantui/commands/sync.py:61
msgid ""
"retry draft creates whose previous outcome was unknown, after checking the "
"provider"
msgstr ""
"أعد محاولة إنشاء المسودات التي كانت نتيجة المحاولة السابقة لها غير معروفة، "
"بعد التحقق من المزوّد"

#: src/pykantui/commands/sync.py:63
msgid "do not commit the result"
msgstr "لا تلتزم النتيجة"

#: src/pykantui/commands/tasks.py:21
msgid "add or remove cards"
msgstr "إضافة أو إزالة البطاقات"

#: src/pykantui/commands/tasks.py:25
msgid "add one card, or several numbered ones"
msgstr "أضف بطاقة واحدة أو عدة بطاقات مرقمة"

#: src/pykantui/commands/tasks.py:27
msgid "column id, name or position (default: the first)"
msgstr "معرف العمود أو الاسم أو الموضع (الافتراضي: الأول)"

#: src/pykantui/commands/tasks.py:28
msgid "add this many, numbered from 1"
msgstr "أضف هذا العدد، مرقمة من 1"

#: src/pykantui/commands/tasks.py:29
msgid "body text for the card"
msgstr "النص الأساسي للبطاقة"

#: src/pykantui/commands/tasks.py:30
msgid "due date, or +N for N days from today"
msgstr "تاريخ الاستحقاق، أو +N لمدة N من الأيام من اليوم"

#: src/pykantui/commands/tasks.py:35
msgid "comma-separated card ids that must finish first"
msgstr "معرفات البطاقات المفصولة بفواصل والتي يجب أن تنتهي أولاً"

#: src/pykantui/commands/tasks.py:39
msgid "delete cards by id"
msgstr "حذف البطاقات عن طريق الهوية"

#: src/pykantui/commands/tasks.py:43
msgid "delete every card in a column"
msgstr "احذف كل بطاقة في عمود"

